{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afirmacc.github.io/ia-skill-clonagem-voz/manifest.schema.json",
  "title": "Voice generation manifest",
  "type": "object",
  "required": ["schema_version", "profile_id", "engine", "model", "output_sha256", "fallback_used", "status"],
  "properties": {
    "schema_version": {"const": 1},
    "fallback_used": {"const": false},
    "status": {"enum": ["AGUARDA_QA_HUMANO", "PRONTO", "BLOQUEADO_VOZ"]}
  },
  "additionalProperties": true
}
